[
    {
        "id": "guild-reception",
        "title": "등록 안내",
        "npcName": "베라 클로비스",
        "npcTitle": "길드 접수원",
        "imagePath": "../assets/images/vera.webp",
        "imageAlt": "길드 접수원",
        "defaultNpcLine": "어서 오세요. 제국 중앙 마법사 길드의 접수 창구입니다. 무슨 일로 방문하셨나요?",
        "optionRows": [
            {
                "id": "guild-main",
                "options": [
                    {
                        "id": "guild-purpose",
                        "playerLine": "마법사 길드?",
                        "npcLine": "처음 방문하시는건가요? 마법사 길드는 마법사들이 서로 도와주기 위해 만들어진 단체에요. 주로 정보 공유, 의뢰 알선, 신원 보증 등의 목적으로 이용되죠. 마법사 길드는 대륙 곳곳에 자리하고 있지만, 하나로 통일된 조직은 아니에요. 각 도시의 독립된 길드들이 서로 업무 협약을 맺어 느슨하게 연결된 형태죠. 그래서 같은 마법사 길드라도 도시마다 규칙과 문화가 조금씩 달라요. 이런 구조는 과거 항마대전쟁에서 용사 일행으로 활약하며 마왕을 타도하는 데 일조한 대현자 루나비스님의 주도로 만들어졌어요."
                    },
                    {
                        "id": "guild-process",
                        "playerLine": "등록 절차?",
                        "npcLine": "등록 신청 서류를 작성해서 제출하시면 돼요. 다만 거짓 정보를 기재하면 길드의 신원 보증이나 각종 지원을 받기 어려워질 수 있으니, 반드시 사실대로 작성해 주세요. 서류를 제출하신 뒤에는 담당자의 안내에 따라 시연장으로 이동해서, 본인의 시그니처 마법을 시연하시면 됩니다."
                    },
                    {
                        "id": "guild-vera",
                        "playerLine": "이름?",
                        "npcLine": "제국 중앙 마법사 길드의 접수원, 베라 클로비스입니다."
                    }
                ]
            },
            {
                "id": "guild-process-followups",
                "visibleWhen": { "choiceSelected": "guild-process" },
                "options": [
                    {
                        "id": "guild-process-read",
                        "playerLine": "글을 못 읽는다.",
                        "npcLine": "...? 마법사 아니신가요? 마법사가 글을 모른다니요, 말이 되는 소릴 해주세요.\n...하아, 제가 읽어드릴테니까 말로 답변해주세요. 작성은 제가 할테니 서명만 해주세요.",
                        "npcImagePath": "../assets/images/vera_disgust.webp",
                        "npcImageAlt": "불쾌한 표정"
                    },
                    {
                        "id": "guild-process-signature",
                        "playerLine": "시그니처 마법?",
                        "npcLine": "...마법사시면 당연히 알고 계셔야 하는 거 아닌가요? 으음, 아무래도 자세한 내용은 저보다는 담당자분께 물어보시는 게 좋을거에요. 마법에 정통하신데다가, 워낙 설명하는 걸 좋아하시는 분이니까요."
                    },
                    {
                        "id": "guild-process-otherman",
                        "playerLine": "담당자는?",
                        "npcLine": "루아른 오라이어양이에요. 나이가 어린데도 대단한 성취를 이룬 분이에요.\n...혹시나 해서 하는 말인데 어리다고 함부로 대하지는 말아주세요."
                    }
                ]
            },
            {
                "id": "guild-vera-followups",
                "visibleWhen": { "choiceSelected": "guild-vera" },
                "options": [
                    {
                        "id": "guild-vera-mage",
                        "playerLine": "마법사?",
                        "npcLine": "아뇨, 저는 그냥 접수원일 뿐입니다. 마법사 길드라고 해서 꼭 마법사만 있을 필요는 없죠."
                    },
                    {
                        "id": "guild-vera-personal",
                        "playerLine": "애인은? 사는 곳? 나이는?",
                        "npcLine": "쯧. 사적인 질문은 삼가해주세요. 여기는 그런 곳 아닙니다.\n계속 이러시면 경비를 부를거에요.",
                        "npcImagePath": "../assets/images/vera_disgust.webp",
                        "npcImageAlt": "불쾌한 표정"
                    }
                ]
            }
        ]
    },
    {
        "id": "node-composition-intro",
        "title": "시그니처 마법 시연",
        "npcName": "루아른 오라이어",
        "npcTitle": "시그니처 마법 기록원",
        "imagePath": "../assets/images/luarn.webp",
        "imageAlt": "루아른 오라이어",
        "defaultNpcLine": "제가 시그니처 기록 담당자인데요. 궁금한 거 있으면 지금 물어보세요. 없으면 바로 시연 시작하고요.",
        "optionRows": [
            {
                "id": "node-intro-main",
                "options": [
                    {
                        "id": "node-intro-explain",
                        "playerLine": "시그니처 마법?",
                        "npcLine": "당신도 마법사라면 모르실 리가 없을텐데요.\n...마법사가 자신임을 증명하는 마법이에요. 다른 누구도 재현할 수 없는, 스스로를 증명하는, 자신만의 오리지널 마법. 과거 항마대전쟁에서 외형을 모방하여 인간 사회에 잠입한 후 공작을 벌이는 마족을 감별하기 위한 수단이었죠. 그게 전쟁이 끝난 이후에도 마법사 사회의 문화로 자리 잡은거고요."
                    },
                    {
                        "id": "node-intro-magic",
                        "playerLine": "마법에 대해",
                        "npcLine": "지금 저를 시험하시려는건가요? 엣, 저에게 가르침을 청하고 싶다고요? 좋아요, 그런거라면 마음껏 물어보세요. 마법 지식이라면 누구보다 자신 있거든요. 그리고 이거 딱히 제 자랑은 아닌데요, 스승님께서 저 정도면 웬만한 아타라의 교수들보다 뛰어나다고 하셨거든요.",
                        "npcImagePath": "../assets/images/luarn_explain.webp",
                        "npcImageAlt": "신난 표정"
                    },
                    {
                        "id": "node-intro-luarn",
                        "playerLine": "이름이?",
                        "npcLine": "루아른 오라이어인데요. 이름은 왜 물으시나요?"
                    }
                ]
            },
            {
                "id": "node-intro-explain-followups",
                "visibleWhen": { "choiceSelected": "node-intro-explain" },
                "options": [
                    {
                        "id": "node-intro-explain-not-exist",
                        "playerLine": "시그니처가 없다.",
                        "npcLine": [
                            {
                                "text": "...진심이신가요. 그러고 참 잘도 마법사 길드에 등록하러 오셨네요. "
                            },
                            {
                                "text": "하여간, 남들 따라하는거에만 급급한 요즘 마법사들은 이래서 안된다니까요.",
                                "variant": "mumble"
                            },
                            {
                                "text": " 없으시면 그냥 가장 자신 있는 마법을 선보이시면 돼요. 신분 증명이야 다 옛날 얘기고요, 현재 마법사 길드에서 시그니처는 개인의 실력과 특기 분야를 평가하는 것에 의미가 있으니까요."
                            }
                        ],
                        "npcImagePath": "../assets/images/luarn_disgust.webp",
                        "npcImageAlt": "불쾌한 표정"
                    },
                    {
                        "id": "node-intro-explain-not-show",
                        "playerLine": "공개할 수 없다.",
                        "npcLine": "아 네, 그러셔요~. 뭐든간에 마법을 보여줘야만 등록할 수 있으니까 알아서 하세요~.",
                        "npcImagePath": "../assets/images/luarn_disgust.webp",
                        "npcImageAlt": "불쾌한 표정"
                    }
                ]
            },
            {
                "id": "node-intro-magic-followups",
                "visibleWhen": { "choiceSelected": "node-intro-magic" },
                "options": [
                    {
                        "id": "node-intro-magic-mana",
                        "playerLine": "마나?",
                        "npcLine": "마나는 마법의 재료이자 연료인데요, 더 근본적으로는, 우주가 순환하는 힘이에요.\n\n천체가 하늘을 돌고, 계절이 뒤바뀌고, 아이가 자라 다시 새 생명을 잉태하는 것. 그 모든 순환 속에서 마나는 흘러나와요.\n\n사람의 몸에서도 마나는 생겨나요. 심장이 뛰고, 피가 돌고, 숨이 오가고, 감정이 흔들리는 것 또한 작은 순환이잖아요. 다만 그 양이 너무나 미약하고, 붙잡지 않으면 금세 흩어져버리지만요.\n\n그래서 마법사는 세상에 떠도는 마나를 붙잡아 자신의 몸속에 들여요. 그리고 그것을 몸 안에서 순환시켜, 잠시 자신의 흐름에 편입시키는 거예요.\n\n인체 또한 하나의 작은 우주이기 때문에 가능한거에요.\n\n마법이란, 그렇게 받아들인 마나를 정렬시켜 인위적으로 세상에 새로운 순환을 일으키는 행위에요."
                    },
                    {
                        "id": "node-intro-magic-unit",
                        "playerLine": "단위 마법?",
                        "npcLine": "단위 마법은 일정한 작용을 일으키는 가장 작은 단위의 마법인데요. 하나하나는 단순한 효과만 내지만, 여러 단위 마법을 연쇄하고 조합해서 복잡한 마법을 구현할 수 있어요.\n\n널리 사용되는 단위 마법은 효과와 안정성이 충분히 규명되어 있는 것들이에요. 하지만 폐쇄적인 학파나 집단에서는 외부에 공표하지 않은 비전의 단위 마법을 사용하기도 해요."
                    },
                    {
                        "id": "node-intro-magic-circle",
                        "playerLine": "서클?",
                        "npcLine": "여러 단위 마법을 연쇄해서 하나의 술식 단위인데요. 마나는 본래 흩어지는 성질을 지니고 있어서, 서클에 포함된 단위 마법이 많아질수록 불안정성이 지수적으로 증가해요. 그래서 복잡한 마법을 사용하려면 시전자도 상당한 부담을 감수해야 돼요. 하지만 숙련된 마법사라면 술식을 여러 서클로 나누고, 그 서클들을 동시에 운용하는 방식으로 부담을 줄일 수 있어요.\n\n참고로 저는 벌써 4서클까지 동시에 운용할 수 있거든요? 제 나이 또래에서는 3서클만 되어도 천재 소리를 듣는데 말이에요. 어때요, 대단하죠?"
                    }
                ]
            },
            {
                "id": "node-intro-luarn-followups",
                "visibleWhen": { "choiceSelected": "node-intro-luarn" },
                "options": [
                    {
                        "id": "node-intro-luarn-young",
                        "playerLine": "어려보이는데.",
                        "npcLine": "나이는 별로 안 중요한데요? 이래뵈도 4서클 마법사에요. 무시하지 말아주세요."
                    },
                    {
                        "id": "node-intro-luarn-recruit",
                        "playerLine": "영입 제안",
                        "npcLine": "...그건 싫은데요. 저 지금 하는 일이 편하고 좋은데요. 그리고 낯선 사람 함부로 따라갈만큼 순진하지는 않거든요? 게다가 당신, 제 스승님만큼 대단해보이지도 않고요.",
                        "npcImagePath": "../assets/images/luarn_disgust.webp",
                        "npcImageAlt": "불쾌한 표정"
                    }
                ]
            }
        ]
    },
    {
        "id": "node-composition-result",
        "title": "시그니처 마법 평가",
        "npcName": "루아른 오라이어",
        "npcTitle": "시그니처 마법 기록원",
        "imagePath": "../assets/images/luarn.webp",
        "imageAlt": "루아른 오라이어",
        "defaultNpcLine": "추가 예정."
    },
    {
        "id": "node-composition-result-test",
        "title": "시그니처 마법 평가",
        "npcName": "루아른 오라이어",
        "npcTitle": "시그니처 마법 기록원",
        "imagePath": "../assets/images/luarn.webp",
        "imageAlt": "루아른 오라이어",
        "defaultNpcLine": "시연 결과를 확인해볼게요. 마법진이 제대로 형성됐는지부터 보죠.",
        "resultLines": [
            {
                "when": { "totalStats": { "instability": { "min": 12 } } },
                "npcLine": "으음, 출력 이전에 안정성이 문제네요. 이 정도 불안정성이면 실전에서 매번 같은 결과를 기대하긴 어려워요."
            },
            {
                "when": { "circleCount": { "max": 0 } },
                "npcLine": "아직 완성된 서클이 없네요. 단위 마법을 연결해서 하나의 흐름을 먼저 만들어야 평가할 수 있어요."
            },
            {
                "when": { "circleCount": { "min": 1 } },
                "npcLine": "좋아요. 최소한 서클은 형성됐네요. 이제 이 구조가 어떤 성향의 마법인지 살펴볼 수 있겠어요."
            }
        ],
        "optionRows": [
            {
                "id": "node-result-main",
                "options": [
                    {
                        "id": "node-result-criteria",
                        "playerLine": "평가 기준은?",
                        "npcLine": "서클이 성립했는지, 출력과 비용이 균형을 이루는지, 그리고 불안정성이 감당 가능한 수준인지 봐요. 보기 좋은 마법진보다 재현 가능한 구조가 더 중요하고요."
                    },
                    {
                        "id": "node-result-next",
                        "playerLine": "다음엔 뭘 하면 되지?",
                        "npcLine": "지금 구조에서 가장 약한 부분을 하나만 고쳐보세요. 한 번에 전부 바꾸면 어떤 변화가 효과를 냈는지 알기 어려우니까요."
                    }
                ]
            },
            {
                "id": "node-result-no-circle",
                "resultWhen": { "circleCount": { "max": 0 } },
                "options": [
                    {
                        "id": "node-result-no-circle-help",
                        "playerLine": "서클을 만들려면?",
                        "npcLine": "시작점에서 출력점까지 끊기지 않게 단위 마법을 연결하세요. 연결이 중간에서 멈추면 마법진이 아니라 부품 목록에 가까워요."
                    }
                ]
            },
            {
                "id": "node-result-unstable",
                "resultWhen": { "totalStats": { "instability": { "min": 12 } } },
                "options": [
                    {
                        "id": "node-result-stabilize",
                        "playerLine": "불안정성을 낮추려면?",
                        "npcLine": "분기와 합류가 많을수록 계산이 까다로워져요. 서클을 나누거나, 불필요한 연결을 줄이거나, 안정성이 높은 단위 마법을 중간에 끼워보세요."
                    }
                ]
            }
        ]
    }
]
