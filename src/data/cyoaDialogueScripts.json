[
    {
        "id": "guild-reception",
        "title": "등록 안내",
        "npcName": "베라 클로비스",
        "npcTitle": "길드 접수원",
        "imagePath": "../assets/images/vera.webp",
        "imageAlt": "길드 접수원",
        "defaultNpcLine": "어서 오세요. 제국 중앙 마법사 길드의 접수 창구입니다. 무슨 일로 방문하셨나요?",
        "optionRows": [
            {
                "id": "guild-main",
                "options": [
                    {
                        "id": "guild-purpose",
                        "playerLine": "마법사 길드는 뭐하는 곳인가요?",
                        "npcLine": "test"
                    },
                    {
                        "id": "guild-process",
                        "playerLine": "접수 절차는?",
                        "npcLine": "등록 신청 서류에 인적사항과 등록에 필요한 내용을 적어서 제출하시면 됩니다. 서류에 반드시 사실만을 적을 필요는 없습니다. 마법사는 원래 비밀이 많은 이들이니까요. 다만, 그러면 행정상의 혜택을 받을 수 없기 때문에 정확하게 기입하시는 걸 추천드립니다. 제출 후에는 담당자를 따라 시연장으로 가서 시그니처 마법을 시연하시면 됩니다."
                    },
                    {
                        "id": "guild-vera",
                        "playerLine": "이름이 어떻게 되시나요?",
                        "npcLine": "제국 중앙 마법사 길드의 접수원, 베라 클로비스입니다."
                    }
                ]
            },
            {
                "id": "guild-purpose-followups",
                "visibleWhen": { "choiceSelected": "guild-purpose" },
                "options": [
                    {
                        "id": "guild-purpose-work",
                        "playerLine": "길드가 맡는 업무를 알고 싶어요.",
                        "npcLine": "마법사 길드는 의뢰 중개, 신원 보증, 사고 보상 절차를 맡습니다. 마법 사용 기록을 남겨서 마법사와 의뢰인 모두를 보호하는 곳이에요."
                    },
                    {
                        "id": "guild-purpose-registration",
                        "playerLine": "등록하면 무엇이 달라지나요?",
                        "npcLine": "등록된 마법사는 공식 의뢰를 받을 수 있고, 길드 설비를 이용할 수 있습니다. 대신 마법진과 신원 정보가 기록되니 책임도 함께 생깁니다."
                    }
                ]
            },
            {
                "id": "guild-process-followups",
                "visibleWhen": { "choiceSelected": "guild-process" },
                "options": [
                    {
                        "id": "guild-process-read",
                        "playerLine": "글을 못 읽는다.",
                        "npcLine": "...? 마법사 아니신가요? 마법사가 글을 모른다니요, 말이 되는 소릴 해주세요.\n...하아, 제가 읽어드릴테니까 말로 답변해주세요. 작성은 제가 해드릴테니 서명만 해주세요.",
                        "npcImagePath": "../assets/images/vera_disgust.webp",
                        "npcImageAlt": "불쾌한 표정"
                    },
                    {
                        "id": "guild-process-otherman",
                        "playerLine": "담당자는?",
                        "npcLine": "루아른 오라이어양이에요. 어리다고 함부로 대하지는 말아주세요."
                    }
                ]
            },
            {
                "id": "guild-vera-followups",
                "visibleWhen": { "choiceSelected": "guild-vera" },
                "options": [
                    {
                        "id": "guild-vera-mage",
                        "playerLine": "마법사?",
                        "npcLine": "아뇨, 저는 그냥 접수원일 뿐입니다. 마법사 길드라고 해서 꼭 마법사만 있을 필요는 없죠."
                    },
                    {
                        "id": "guild-vera-personal",
                        "playerLine": "애인은? 사는 곳? 나이는?",
                        "npcLine": "쯧. 사적인 질문은 삼가해주세요.\n여기는 그런 곳 아닙니다.\n계속 이러시면 경비를 부를거에요.",
                        "npcImagePath": "../assets/images/vera_disgust.webp",
                        "npcImageAlt": "불쾌한 표정"
                    }
                ]
            }
        ]
    },
    {
        "id": "node-composition-intro",
        "title": "시그니처 마법 시연",
        "npcName": "루아른 오라이어",
        "npcTitle": "시그니처 마법 평가원",
        "imagePath": "../assets/images/luarn.webp",
        "imageAlt": "루아른 오라이어",
        "defaultNpcLine": "시연을 시작하기 전에 궁금한 점이 있으면 물어보세요.",
        "optionRows": [
            {
                "id": "node-intro-main",
                "options": [
                    {
                        "id": "node-intro-explain",
                        "playerLine": "시그니처 마법이란?",
                        "npcLine": "당신도 마법사라면 모르실 리가 없을텐데요.\n...마법사가 자신임을 증명하는 마법이에요. 다른 누구도 재현할 수 없는, 자신을 증명하는, 자신만의 오리지널 마법. 과거 항마대전에서 외형을 모방하여 잠입하는 마족에게 대항하기 위한 수단이었죠. 그게 전쟁이 끝난 이후에도 마법사 사회의 전통으로 자리 잡은거고요."
                    },
                    {
                        "id": "node-intro-connection",
                        "playerLine": "연결은 어떤 의미인가요?",
                        "npcLine": "연결은 마력이 흐르는 순서를 뜻합니다. 마나 공급원에서 시작해 필요한 노드를 거친 뒤 최종 출력으로 이어져야 실제 계산에 반영됩니다."
                    },
                    {
                        "id": "node-intro-luarn",
                        "playerLine": "이름이?",
                        "npcLine": "루아른 오라이어인데요."
                    }
                ]
            },
            {
                "id": "node-intro-explain-followups",
                "visibleWhen": { "choiceSelected": "node-intro-explain" },
                "options": [
                    {
                        "id": "node-intro-explain-not-exist",
                        "playerLine": "시그니처가 없다.",
                        "npcLine": [
                            {
                                "text": "...진심이신가요. 그러고도 참 잘 마법사 길드에 등록하러 오셨네요. "
                            },
                            {
                                "text": "하여간, 요즘 마법사들은 이래서 안된다니까요.",
                                "variant": "mumble"
                            },
                            {
                                "text": " 없으시면 그냥 가장 자신 있는 마법을 선보이시면 돼요. 신분 증명이야 다 옛날 얘기고요, 지금은 개인의 실력을 평가하는 것에 의미가 있죠. 지금 시대에는 신분을 증명할 수단이 얼마나 많은데요."
                            }
                        ],
                        "npcImagePath": "../assets/images/luarn_disgust.webp",
                        "npcImageAlt": "불쾌한 표정"
                    },
                    {
                        "id": "node-intro-explain-connection",
                        "playerLine": "연결은 어떤 의미인가요?",
                        "npcLine": "연결은 마력이 흐르는 순서를 뜻합니다. 마나 공급원에서 시작해 필요한 노드를 거친 뒤 최종 출력으로 이어져야 실제 계산에 반영됩니다."
                    },
                    {
                        "id": "node-intro-explain-luarn",
                        "playerLine": "이름이?",
                        "npcLine": "루아른 오라이어인데요."
                    }
                ]
            },
            {
                "id": "node-intro-luarn-followups",
                "visibleWhen": { "anyChoiceSelected": ["node-intro-luarn", "node-intro-explain-luarn"] },
                "options": [
                    {
                        "id": "node-intro-luarn-young",
                        "playerLine": "어려보이는데.",
                        "npcLine": "이래뵈도 5서클 마법사인데요. 무시하지 말아주세요."
                    },
                    {
                        "id": "node-intro-luarn-signature",
                        "playerLine": "네 시그니처 마법은?",
                        "npcLine": "주문 모방. 4서클 이하의 마법은 즉석에서 해석해서 따라할 수 있어요.\n...좀 더 치켜세워주셔도 괜찮은데요. 당신도 마법사니까 이게 얼마나 대단한 기예인지 아시잖아요."
                    },
                    {
                        "id": "node-intro-luarn-recruit",
                        "playerLine": "영입 제안",
                        "npcLine": "...그건 싫은데요. 저 지금 하는 일이 편하고 좋은데요. 그리고 낯선 사람 함부로 따라갈만큼 순진하지는 않거든요? 게다가 당신, 제 스승님만큼 대단해보이지도 않고요.",
                        "npcImagePath": "../assets/images/luarn_disgust.webp",
                        "npcImageAlt": "불쾌한 표정"
                    }
                ]
            }
        ]
    }
]
